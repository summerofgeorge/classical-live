{
  "bu": "<div class=\"bu_collapsible_container \" aria-live=\"polite\" data-customize-animation=\"false\"><h3 class=\"bu_collapsible\" aria-expanded=\"false\" tabindex=\"0\" role=\"button\">Fall 2026 Schedule</h3><div class=\"bu_collapsible_section\" style=\"display: none;\"><p></p>\n<p><strong>Friday, September 25 | 7:30pm</strong><br>\nBoston University Symphony Orchestra</p>\n<p><strong>Monday, September 28 | 7:30pm</strong><br>\nBoston University Chamber Orchestra</p>\n<p><strong>Thursday, October 1 | 7:30pm</strong><br>\nBoston University Wind Ensemble</p>\n<p>Note: Events will be added throughout the semester.</p>\n<p></p></div>\n</div>",
  "hartt": "<div class=\"capsule-interior-pad\">\n                    \n                        \n                                    \n                        \n                            <!--<h3>Join Us in the Fall Semester for more Live Events at The Hartt School</h3>-->\n<h3>Hartt Wind Ensemble</h3>\n<p><strong>September 29, 2026 - 7:30 pm EST<br></strong></p>\n<div style=\"position: relative; padding-bottom: 56.25%; padding-top: 0px; height: 0; overflow: auto; -webkit-overflow-scrolling: touch;\"><iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"allowfullscreen\" frameborder=\"0\" height=\"150\" src=\"https://www.youtube.com/embed/7pvljc3x8Jw\" style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%;\" title=\"YouTube video player\" width=\"300\"></iframe></div>\n                        \n                                                            \n            \n                    </div>",
  "ithaca": "<main><div class=\"body-text\">The list of all that we will have available to stream<p>Oct<br>8 – Thurs – 7pm – Ford – Jazz Ensemble with Wind Ensemble<br>11 – Sun – 4pm – Ford – Concert Band<br>16 – Fri – 7pm – Ford – Wind Ensemble with Jazz Ensemble<br>30 – Fri – 7pm – Ford – Symphony Orchestra</p></div></main>",
  "fsu": "<p>Content is only available on this channel during one of the following scheduled events</p><table><tr>\n\t\t\t\t\t\t\t<td width=\"50%\">October 10, 2026 at 7:30 pm EDT</td>\n\t\t\t\t\t\t\t<td width=\"50%\">University Symphony Orchestra</td>\n\t\t\t\t\t\t</tr><tr>\n\t\t\t\t\t\t\t<td width=\"50%\">October 12, 2026 at 7:30 pm EDT</td>\n\t\t\t\t\t\t\t<td width=\"50%\">FSU Honors Jazz Combo</td>\n\t\t\t\t\t\t</tr><tr>\n\t\t\t\t\t\t\t<td width=\"50%\">November 1, 2026 at 3 pm EDT</td>\n\t\t\t\t\t\t\t<td width=\"50%\">FSU Opera: Of Mice and Men</td>\n\t\t\t\t\t\t</tr></table>",
  "crane": "<h3><br><br>Next Live-Streamed Event</h3><p><br><span>Monday September 28, 2026 at 7:30 p.m.; in Snell Music Theater</span><br><a href=\"https://sunypotsdam.sharepoint.com/:b:/t/CraneConcertPrograms2/IQDKGis7LJuYQapMxuJY6kVRAXu_ZG5r1tvngBzt5OT5ZKU?e=NKs4Ly\"><span><strong>Faculty Chamber Recital, Julia Trio</strong></span></a><br><br><a href=\"https://www.youtube.com/playlist?list=PLtuXOQFKehOIrf2LDcTZG4ntttJ0ZnhSJ\">Watch the Livestream</a><br>&nbsp;</p><h3>Upcoming Performances</h3><p>Tuesday September 29, 2026 at 7:30 p.m. <strong>Not confirmed as streamed</strong></p>",
  "csulb": "<div class=\"mix event string-studies  current\" data-ensemble=\"Faculty Baroque Trio\" data-director=\"John Barcellona&amp;mdash;flute, David Garrett&amp;mdash;viola da gamba, &amp;amp; Elizabeth Lindau&amp;mdash;harpsichord\" data-date=\"Friday, October 9, 2026\" data-venue=\"Daniel Recital Hall\">\n                              <h2 class=\"eventtitle\">Faculty Baroque Trio\n                              </h2>\n                              <h3 class=\"event-director\">John Barcellona—flute, David Garrett—viola da gamba, &amp; Elizabeth Lindau—harpsichord</h3>\n                              <div class=\"description\">\n                              </div>\n                              <ul class=\"eventdetails\">\n                                <li class=\"icon date\">Friday, October 9, 2026</li>\n                                <li class=\"icon time\">7:30pm</li>\n                                <li class=\"icon venue\">Daniel Recital Hall</li>\n                                <li class=\"icon tickets\">Tickets FREE</li>\n                              </ul>\n                            </div><div class=\"mix event vocal-studies  current\" data-ensemble=\"Voice Area Recital\" data-director=\"Alexander Hahn, director\" data-date=\"Saturday, October 10, 2026\" data-venue=\"Daniel Recital Hall\">\n                              <h2 class=\"eventtitle\">Voice Area Recital\n                              </h2>\n                              <h3 class=\"event-director\">Alexander Hahn, director</h3>\n                              <div class=\"description\"><p>Select BCCM singers present an evening of art songs and arias.</p>\n                              </div>\n                              <ul class=\"eventdetails\">\n                                <li class=\"icon date\">Saturday, October 10, 2026</li>\n                                <li class=\"icon time\">7:30pm</li>\n                                <li class=\"icon venue\">Daniel Recital Hall</li>\n 